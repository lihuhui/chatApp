 *   quota_date        — 配额日期 (YYYY-MM-DD)
 */
{
  "app_config": {
    "data": [],
    "indexes": [
      {
        "name": "user_id_1_quota_date_1",
        "keys": { "user_id": 1, "quota_date": 1 }
      }
    ]
  }
}
